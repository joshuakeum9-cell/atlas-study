# Atlas runs entirely on local mock data. Every variable below is OPTIONAL and
# unused by the prototype - the app builds and runs with this file absent.
# They are placeholders showing where real services would be wired in if this
# concept were ever taken past the prototype stage. See src/services/README.md.

# AI tutor (chat completions / streaming explanations)
VITE_AI_API_BASE=
VITE_AI_MODEL=

# Handwriting recognition on a selected region of a worksheet
VITE_OCR_API_BASE=

# Speech to text for the microphone button
VITE_SPEECH_API_BASE=

# Semantic / natural-language document search
VITE_SEARCH_API_BASE=

# File storage and share links
VITE_STORAGE_API_BASE=
